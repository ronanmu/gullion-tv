		<key id="KEY_YELLOW" mapto="subtitles" flags="m" />
		<key id="KEY_YELLOW" mapto="release" flags="blr" />
		<key id="KEY_INFO" mapto="show" flags="m" />
		<key id="KEY_INFO" mapto="release" flags="blr" />
		<key id="KEY_UP" mapto="up" flags="m" />
