<keymap>
	<!-- STOP on live TV stops the channel's recording (Gullion TV's InfoBar actions, hook.py). -->
	<map context="GullionLiveActions">
		<key id="KEY_STOP" mapto="stop" flags="m" />
	</map>
	<!-- Recording controls consume both key edges before the stock player maps. -->
	<map context="GullionPlaybackActions">
		<key id="KEY_LEFT" mapto="left" flags="mr" />
		<key id="KEY_LEFT" mapto="release" flags="bl" />
		<key id="KEY_RIGHT" mapto="right" flags="mr" />
		<key id="KEY_RIGHT" mapto="release" flags="bl" />
		<key id="KEY_OK" mapto="ok" flags="m" />
		<key id="KEY_OK" mapto="release" flags="blr" />
		<key id="KEY_EXIT" mapto="back" flags="m" />
		<key id="KEY_EXIT" mapto="release" flags="blr" />
		<key id="KEY_BACK" mapto="back" flags="m" />
		<key id="KEY_BACK" mapto="release" flags="blr" />
		<key id="KEY_STOP" mapto="stop" flags="m" />
		<key id="KEY_STOP" mapto="release" flags="blr" />
		<key id="KEY_PLAY" mapto="play" flags="m" />
		<key id="KEY_PLAY" mapto="release" flags="blr" />
		<key id="KEY_PAUSE" mapto="pause" flags="m" />
